# Copy to .env and fill LLM_API_KEY. Existing shell env vars take precedence.

# LLM (required for generate/check when calling the API)
LLM_API_KEY=sk-f2957f2925074283b8b6c0391d489559

# Review model name (default in code: qwen3.5-plus)
CHECK_REVIEW_MODEL=qwen3.5-plus

# Clause locate: set to 1 / true / yes to enable LLM fallback for locating clauses
CHECK_CLAUSE_LOCATE_LLM=1

# Max contract characters sent to the clause-locate prompt
CHECK_CLAUSE_LOCATE_MAX_CHARS=14000

# Parallelism (reduce if API rate-limits)
CHECK_SEMANTIC_REVIEW_MAX_WORKERS=4
CHECK_RULE_CLAUSE_EXTRACT_MAX_WORKERS=8
